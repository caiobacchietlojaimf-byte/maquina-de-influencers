# Higgsfield Platform API (mesma API usada pelo open-higgsfield). Formato: id:secret
HF_API_KEY=
HF_API_BASE_URL=https://platform.higgsfield.ai

# Segredo para assinar sessões (se vazio, um é gerado em data/.secret)
AUTH_SECRET=

# URL pública do app (necessária para o Higgsfield buscar uploads locais; ex.: https://xxxx.ngrok.app)
PUBLIC_BASE_URL=http://localhost:3000

# Opcional: Vercel Blob para uploads públicos (recomendado em produção)
BLOB_READ_WRITE_TOKEN=

# Opcional: Claude para gerar prompts de replicação dos vídeos virais
ANTHROPIC_API_KEY=

# Créditos iniciais para contas novas
INITIAL_CREDITS=10000
