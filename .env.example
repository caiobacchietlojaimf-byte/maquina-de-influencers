# Higgsfield Platform API (mesma API usada pelo open-higgsfield). Formato: id:secret
HF_API_KEY=
HF_API_BASE_URL=https://platform.higgsfield.ai

# Segredo para assinar sessões (se vazio, um é gerado em data/.secret)
AUTH_SECRET=

# URL pública do app (OAuth do TikTok e uploads; ex.: https://xxxx.ngrok.app)
PUBLIC_BASE_URL=http://localhost:3000

# TikTok Content Posting API (developers.tiktok.com, escopo video.publish).
# Sem essas chaves, Conectar TikTok cria uma conta demo que simula a publicação.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram: nao usa .env — cole o IG User ID + access token do Graph API
# (escopo instagram_content_publish) direto na pagina Publicar.

# Créditos iniciais para contas novas
INITIAL_CREDITS=10000

# Banco persistente (Supabase Postgres). Sem essas 3, cai no JSON local (data/db.json).
SUPABASE_URL=
SUPABASE_KEY=
MI_DB_SECRET=
