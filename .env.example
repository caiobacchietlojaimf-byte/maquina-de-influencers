# Higgsfield Platform API (mesma API usada pelo open-higgsfield). Formato: id:secret
HF_API_KEY=
HF_API_BASE_URL=https://api.higgsfield.ai

# Fotos de identidade/estilo, apenas no servidor
BLOB_READ_WRITE_TOKEN=

# fal.ai (somente servidor; nunca use prefixo NEXT_PUBLIC_)
FAL_KEY=

# Segredo para assinar sessões. Obrigatório na Vercel; fallback só no dev local.
AUTH_SECRET=

# URL pública do app (OAuth do TikTok e uploads; ex.: https://xxxx.ngrok.app)
PUBLIC_BASE_URL=http://localhost:3000

# Tokens sociais: chave AES-256 de 32 bytes em base64 (ou 64 caracteres hex).
# Gere uma vez e mantenha estável. Somente servidor.
SOCIAL_TOKEN_SECRET=

# Instagram API com Instagram Login (ID/segredo próprios do produto Instagram).
# Callback: PUBLIC_BASE_URL/api/oauth/instagram/callback
# Conta profissional, scopes instagram_business_basic e instagram_business_content_publish.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Alternativa usada na Vercel: preencha o par completo. Tem prioridade sobre o par acima.
# Nunca misture o ID de um par com o segredo do outro; ambos ficam no servidor.
ID_INSTAGRAM=
SECRET_INSTAGRAM=

# TikTok Content Posting API (developers.tiktok.com, user.info.basic + video.publish).
# Callback: PUBLIC_BASE_URL/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Prefixos HTTPS de armazenamento VERIFICADOS no painel TikTok, separados por vírgula.
TIKTOK_VERIFIED_MEDIA_PREFIXES=

# Coleta automática de vídeos virais (cron /api/cron/virals + agendador local).
# Desligada por padrão: só "true" liga. Com qualquer outro valor o cron encerra
# sem consultar provedores, mesmo declarado no vercel.json.
VIRAL_COLLECTION_ENABLED=false

# Descoberta no YouTube pela API oficial (YouTube Data API v3), complemento
# desligado por padrão: exige a chave E YOUTUBE_DISCOVERY_ENABLED=true. Cota
# padrão (documentação oficial): 100 chamadas search.list/dia (bucket próprio,
# 1 por chamada) e 10.000 unidades/dia para os demais métodos; reinicia à meia-
# noite no horário do Pacífico. O coletor faz 2 buscas por hora (48/dia).
YOUTUBE_API_KEY=
YOUTUBE_DISCOVERY_ENABLED=false

# Cron autenticado. Na Vercel, o plano precisa aceitar o intervalo configurado.
CRON_SECRET=
# Marque true somente após confirmar que o cron foi ativado no ambiente.
PUBLICATION_CRON_CONFIGURED=false

# Créditos iniciais para contas novas
INITIAL_CREDITS=0

# UUIDs das contas administradoras, definidos somente no servidor.
# Nunca use campo de cadastro, e-mail ou parâmetro do navegador para conceder administração.
ADMIN_USER_IDS=

# Sync Pay: credenciais do seller + segredo retornado pelo webhook event=transaction.
# Cadastre /api/payments/syncpay/webhook no gateway e autorize a infraestrutura/IP da API.
# Nunca use NEXT_PUBLIC_ para estas variáveis. O checkout permanece fechado sem as três.
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_WEBHOOK_SECRET=

# Banco persistente (Supabase Postgres). Sem essas 3, cai no JSON local (data/db.json).
SUPABASE_URL=
SUPABASE_KEY=
MI_DB_SECRET=

# Login com Google (OAuth 2.0 / OpenID Connect, credencial "Aplicativo da Web" no Google Cloud).
# Origem autorizada: PUBLIC_BASE_URL. Redirect exato: PUBLIC_BASE_URL/api/auth/google/callback
# Sem o par, o botão "Continuar com Google" avisa que o login está indisponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
