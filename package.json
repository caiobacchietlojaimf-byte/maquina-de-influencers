{
  "name": "maquina-de-influencers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "npm run validate:media && npm run validate:traits && next build",
    "validate:media": "node scripts/validate-viral-media.mjs",
    "validate:traits": "node scripts/sync-influencer-traits.mjs --check",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/blob": "^2.8.1",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "yazl": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^5.9.2"
  }
}
